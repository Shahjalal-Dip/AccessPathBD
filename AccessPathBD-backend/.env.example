NODE_ENV=development         
PORT=5001
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.example   
COOKIE_SECRET=change-me


JWT_BEARER_SECRET=replace-with-a-long-random-string
JWT_TTL=86400                   # token lifetime in seconds (1 day)

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=accesspath_dev
NODE_DB_ENV=development
# DB_SSL=true                   

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- Business rules ----
FRESHNESS_DAYS=90               # verified info older than this is shown as STALE
CONFLICT_WINDOW_DAYS=30         # approved reports this close in time must agree, else DISPUTED

# ---- Evidence uploads ----
UPLOAD_DIR=storage/evidence
UPLOAD_MAX_FILE_MB=5
UPLOAD_MAX_FILES_PER_REPORT=5

# ---- Rate limiting ----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100              # requests per window per IP
AUTH_THROTTLE_LIMIT=10          # login/register attempts per window per IP

# SEED_PASSWORD=Passw0rd!demo
